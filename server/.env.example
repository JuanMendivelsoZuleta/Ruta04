# Puerto del servidor HTTP
PORT=4000

# PostgreSQL (Neon). Usa la connection string DIRECTA (sin "-pooler").
# Ejemplo: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Cloudinary: almacenamiento persistente de fotografías.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes permitidos por CORS (URL del frontend en Vercel).
# Puede ser una lista separada por comas. En desarrollo: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
