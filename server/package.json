{
  "name": "ruta04-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API del MVP Ruta 04 (marketplace de fotografía deportiva)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:deploy": "prisma migrate deploy && node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:studio": "prisma studio",
    "verify": "tsx src/scripts/verify.ts",
    "verify:demo": "tsx src/scripts/verify-demo.ts",
    "test:events": "tsx src/scripts/test-events.ts",
    "test:photos": "tsx src/scripts/test-photos.ts",
    "test:orders": "tsx src/scripts/test-orders.ts",
    "e2e:cleanup": "tsx src/scripts/e2e-cleanup.ts"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cloudinary": "^2.11.0",
    "express": "5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
